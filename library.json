  "keywords": "lvgl, theme, shadcn, gui, ui, display, touch, embedded",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlixANNERAUD/lvgl_theme_shadcn.git"
  },
  "homepage": "https://github.com/AlixANNERAUD/lvgl_theme_shadcn",
  "authors": [
    {
      "name": "Alix ANNERAUD",
      "email": "alix@anneraud.fr",
      "maintainer": true
    }
  ],
  "license": "MIT",
  "dependencies": [
    {
      "name": "lvgl/lvgl",
      "version": "^9.6.0"
    }
  ],
  "build": {
    "srcDir": "src",
    "includeDir": "include"
  },
  "export": {
    "exclude": [
      "tests",
      "examples",
      "rust",
      "scripts",
