cmake_minimum_required(VERSION 3.25)
include(FetchContent)

set(LV_THEME_SHADCN_TEST_COLOR_FORMAT "LV_COLOR_FORMAT_XRGB8888" CACHE STRING "LV_COLOR_FORMAT_DEFAULT used by tests")
add_compile_definitions(LV_THEME_SHADCN_TEST_COLOR_FORMAT=${LV_THEME_SHADCN_TEST_COLOR_FORMAT})

set(LV_BUILD_CONF_PATH ${CMAKE_CURRENT_LIST_DIR}/conf/lv_conf.h CACHE PATH "" FORCE)
set(CONFIG_LV_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
set(CONFIG_LV_BUILD_DEMOS OFF CACHE BOOL "" FORCE)
set(CONFIG_LV_USE_THORVG OFF CACHE BOOL "" FORCE)
set(CONFIG_LV_USE_THORVG_INTERNAL OFF CACHE BOOL "" FORCE)

FetchContent_Declare(lvgl
  GIT_REPOSITORY https://github.com/lvgl/lvgl.git
  GIT_TAG v9.6.0
  GIT_SHALLOW TRUE
  SYSTEM)
FetchContent_MakeAvailable(lvgl)
